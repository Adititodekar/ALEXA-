# =================================================================
# Nova AI / Alexa-Next Environment Configuration Template
# =================================================================
# Copy this file to .env and configure your credentials.
# Keep your .env file private (it is automatically ignored by Git).

# Choose the chat provider: gemini, openai, or compatible (Groq/Llama etc.).
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=openai,compatible,gemini

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI API (separate billing/key from a ChatGPT subscription):
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# OpenAI-compatible endpoint for Llama via Groq. Set LLM_PROVIDER=compatible.
# Create a key at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Optional: Host and Port configuration (defaults to 127.0.0.1:8000)
# HOST=127.0.0.1
# PORT=8000
