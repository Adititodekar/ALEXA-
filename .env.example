# =================================================================
# Nova AI / Alexa-Next Environment Configuration Template
# =================================================================
# Copy this file to .env and configure your credentials.
# Keep your .env file private (it is automatically ignored by Git).

# Google AI Studio API Key for open-ended knowledge and reasoning.
# Generate your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here...

# Recommended model ID (gemini-3.8-flash is the current active model)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Host and Port configuration (defaults to 127.0.0.1:8000)
# HOST=127.0.0.1
# PORT=8000
